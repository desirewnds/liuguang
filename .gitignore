# Native development caches and test output (never repository source)
node_modules/
.npm-cache/
/.build/
/.publish/
target/
frontend/dist/
src-tauri/engine/
test-artifacts/
__pycache__/
*.pyc
*.tsbuildinfo
*.rmeta
*.rlib
*.pdb
*.ilk
*.exp
*.obj
*.o
*.a
*.lib
*.dmp

# Local applications and release attachments are not repository source
*.exe
*.dll
/release/
/.engine-input/
*.msi
*.msix
*.cab
*.7z
*.zip
*.dmg
*.pkg
*.app/
*.dylib
*.dSYM/

# Only reviewed source, notices and lock manifests belong under engine/ in Git
/engine/*
!/engine/catalog/
!/engine/plugins/
!/engine/licenses/
!/engine/manifest.json
!/engine/downloads.lock.json
!/engine/sources-manifest.json

# Rust locks, native notices/manifests and original small icons are source inputs.
# Ignored parent build/cache directories stay ignored.
!Cargo.lock
!/packaging/*.json
!/packaging/*.ico
!/crates/flow-platform/assets/*.png

# Personal data and local settings
/data/
/downloads/
*.log
*.partial
*.tmp
*.bak
.env
.env.*
!.env.example
cookies.txt
*.cookies.txt
*.sqlite
*.sqlite3
*.db
*.sqlite3-*
*.pem
*.key
*.pfx
*.p12
*.mp4
*.mkv
*.webm
*.m4a
*.mp3
*.flac
